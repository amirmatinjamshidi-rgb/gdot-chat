# Required. REST base including /v1. No hardcoded LAN fallback exists.
# Physical device on same Wi-Fi as the API host:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:5066/v1
# Android emulator (host loopback):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5066/v1
# iOS simulator:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:5066/v1
EXPO_PUBLIC_API_URL=
