{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=gdotchat;Username=gdot"
  },
  "Minio": {
    "Endpoint": "127.0.0.1:9000",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "gdot-attachments",
    "Region": "us-east-1",
    "UseSsl": false,
    "UseServerSideEncryption": false
  },
  "Jwt": {
    "UseEphemeralDevelopmentSigningKey": true
  },
  "Relay": {
    "MaxCiphertextBytes": 65536
  },
  "RateLimits": {
    "SessionResetPermitLimit": 5,
    "SessionResetWindowSeconds": 3600
  }
}
