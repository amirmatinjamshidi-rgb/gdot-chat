{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=gdotchat;Username=gdot"
  },
  "Jwt": {
    "Issuer": "gdot-chat",
    "Audience": "gdot-chat-mobile",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Relay": {
    "EnvelopeTtlDays": 7,
    "PreKeyLowThreshold": 10,
    "MaxCiphertextBytes": 65536
  },
  "Attachments": {
    "MaxSizeBytes": 1073741824,
    "ChunkSizeBytes": 4194304,
    "TtlDays": 7,
    "MaxActivePerDevice": 20,
    "CreatePermitLimit": 20,
    "ChunkPermitLimit": 180
  },
  "Minio": {
    "Endpoint": "127.0.0.1:9000",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "gdot-attachments",
    "Region": "us-east-1",
    "UseSsl": false,
    "UseServerSideEncryption": false
  },
  "RateLimits": {
    "AuthRegisterPermitLimit": 5,
    "AuthRegisterWindowSeconds": 3600,
    "AuthLoginPermitLimit": 20,
    "AuthLoginWindowSeconds": 3600,
    "AuthRefreshPermitLimit": 30,
    "AuthRefreshWindowSeconds": 60,
    "PreKeyFetchCallerPermitLimit": 30,
    "PreKeyFetchCallerWindowSeconds": 60,
    "PreKeyFetchTargetPermitLimit": 60,
    "PreKeyFetchTargetWindowSeconds": 60,
    "MessagesSendPermitLimit": 60,
    "UsersSearchPermitLimit": 30
  }
}
